# DiagGenAI Environment Configuration
# SAFETY MODE
SIMULATION_MODE=true
SAFETY_BANNER="SIMULATION MODE — NO REAL ECU CONNECTION"

# Application Settings
APP_NAME=DiagGenAI
APP_VERSION=1.0.0
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501
BACKEND_API_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite:///./data/diaggenai.db

# Vector Database & Embeddings
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=uds_diagnostic_specs
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# LLM Configuration (Approved / Local / Mock fallback)
LLM_PROVIDER=mock
# Options: mock, openai, local_vllm, huggingface
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
LOCAL_LLM_API_BASE=http://localhost:8000/v1

# Graph / Traceability
GRAPH_ENGINE=networkx
# Options: networkx (in-memory / SQLite backed), neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=diaggenai_secret

# Security & Auth
SECRET_KEY=diaggenai-insecure-dev-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
